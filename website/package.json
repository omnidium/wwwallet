{
  "name": "website",
  "version": "0.0.0",
  "private": true,
  "license": "PolyForm-Strict-1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "build-only": "vite build && vite build --ssr src/entry-server.ts --outDir dist-ssr && node scripts/prerender.mjs",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "format": "prettier --write --experimental-cli src/",
    "sync-locales": "node scripts/sync-locales.mjs",
    "sync-locales:dry-run": "node scripts/sync-locales.mjs --dry-run",
    "deploy": "run-s build deploy-only",
    "deploy-only": "wrangler pages deploy dist --project-name=wwwallet-website --branch=main"
  },
  "dependencies": {
    "vue": "^3.5.40",
    "vue-i18n": "^11.4.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.10.5",
    "eslint-plugin-vue": "~10.11.1",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.2",
    "prettier": "3.9.9",
    "typescript": "~6.0.0",
    "vite": "^8.3.2",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.7",
    "wrangler": "4.147.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
