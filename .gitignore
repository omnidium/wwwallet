# Rust
# Cargo.lock is committed deliberately (this workspace produces a deployable Worker, not a library)
/target/
backend/build/

# wrangler local dev state (KV simulation, bundling temp files)
.wrangler/
backend/node_modules/

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Node / website
website/node_modules/
website/dist/
website/.vite/

# Env / secrets — including the .example templates, which document setup
# locally but aren't needed to build, test or deploy.
.env
.env.*
backend/.dev.vars*

# OS / editor
.DS_Store
*.swp
*.code-workspace
.editorconfig

# Only what's needed to build, test or deploy the app, website and backend
# is kept in the repo. Local-only tools and leftovers:
frontend/zz-shots/
frontend/scripts/
website/scripts/sync-locales.mjs
shared/frontend-public/icons/*_old.*
shared/frontend-public/icons/*maskable2.*
shared/frontend-public/icons/*.py

# Never carry these kinds of artifacts into this repo (see migration plan):
# full project backups/tarballs, python venvs, checked-in TLS certs, service-account keys
*.tar.gz
.venv/
ssl/
*service-account*.json
google_api.json
*.sh

# Playwright MCP tool output (screenshots/console logs from live manual testing)
.playwright-mcp/

docs/
.cheat_sheet.txt
