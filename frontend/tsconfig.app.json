{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue", "../shared/license/*.ts", "../shared/config/links.ts", "../shared/ui/*.vue"],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    // Extra safety for array and object lookups, but may have false positives.
    "noUncheckedIndexedAccess": true,

    // Path mapping for cleaner imports.
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["../shared/*"],
      // ../shared has no node_modules of its own, so nothing would resolve
      // `vue` for the shared components. vue-tsc 3.3.12+ then can't tell
      // their template's constants from refs, and unwraps them as if they
      // were (".value does not exist on '"wwwallet"'").
      "vue": ["./node_modules/vue"]
    },

    // `vue-tsc --build` produces a .tsbuildinfo file for incremental type-checking.
    // Specified here to keep it out of the root directory.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  }
}
