# Copy to .env.local for local development. Never commit the real file.

# Backend BFF base URL.
VITE_API_BASE_URL=http://localhost:8787

# Public Google OAuth 2.0 Client ID (no secret) for Drive appDataFolder backup.
# Create one at https://console.cloud.google.com/apis/credentials — enable the
# Drive API, create an "OAuth client ID" of type "Web application". This value
# is safe to ship in the client bundle; it is not a secret.
VITE_GOOGLE_CLIENT_ID=

# --- Not read by Vite / never shipped to the browser (no VITE_ prefix) ---

# DeepL API key, used only by scripts/sync-locales.mjs to keep
# src/locales/*.ts translated from en.ts (DeepL's 30-language "premium"
# tier only — see that script for why). This one IS a real secret — unlike
# the client ID above, never put a live value in a committed file.
# Create at https://www.deepl.com/en/your-account/keys after signing up for
# the free Developer plan — confirm its current character allowance there,
# DeepL has changed how this plan is packaged more than once.
# Put the real value in frontend/.env.locales (gitignored), or export it in
# your shell/CI secrets instead.
DEEPL_API_KEY=
