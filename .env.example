# Copy to .env for local development. Never commit the real .env.

# MySQL connection used by the Rust backend (reference/localization data only —
# no user, auth, or transaction data is ever stored here; see README).
DATABASE_URL=mysql://webuser:changeme@127.0.0.1:3306/wwwallet

# Address the backend listens on.
BIND_ADDR=0.0.0.0:8080

# Comma-separated list of browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Provider API keys — get free-tier keys from each provider's dashboard.
# These are read only by the backend; they never reach the frontend bundle.
ALCHEMY_API_KEY=
ETHPLORER_API_KEY=
ETHERSCAN_API_KEY=
