# Copy to .env for local development. Never commit the real .env.

# Address the backend listens on.
BIND_ADDR=0.0.0.0:8080

# Comma-separated list of browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Provider API keys — get free-tier keys from each provider's dashboard.
# These are read only by the backend; they never reach the frontend bundle.
ALCHEMY_API_KEY=
ETHPLORER_API_KEY=
ETHERSCAN_API_KEY=
ZEROX_API_KEY=
